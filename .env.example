# Polar Workspace — пример окружения.
# scripts/setup.sh сам скопирует этот файл в .env и подставит домен.
# Домен: A-запись DNS должна указывать на сервер; PUBLIC_ORIGIN — тот же адрес с https.
POLAR_DOMAIN=workspace.example.com
PUBLIC_ORIGIN=https://workspace.example.com
# 1 — cookie сессии только по HTTPS. Для локального http-теста поставьте 0.
SESSION_COOKIE_SECURE=1
# 1 — чат работает через официальный Claude Code CLI (по подписке).
CLAUDE_ENABLED=1
