{
  "name": "polar-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "postinstall": "node node_modules/@anthropic-ai/claude-code/install.cjs",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "API_PORT=3001 tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.292",
    "@vitejs/plugin-react": "^4.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "11.10.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "lucide-react": "^0.468.0",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "concurrently": "10.0.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "~5.7.2",
    "vitest": "5.0.3"
  }
}
