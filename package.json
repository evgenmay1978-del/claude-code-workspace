{
  "name": "polar-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Polar Workspace — личный self-hosted Claude: web-интерфейс + официальный Claude Code CLI по подписке",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs",
    "test:api": "sh server/test/run-smoke.sh",
    "serve": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
